# Copy to .env and fill in. Comments must be on their own line (Docker doesn't strip inline ones).

# Any OpenAI-compatible API. Defaults are Gemini's free tier; get a key at aistudio.google.com.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Comma-separated: later models are used when the first is overloaded.
LLM_MODEL=gemini-3.6-flash,gemini-3.5-flash
# OpenAI instead:    LLM_BASE_URL=https://api.openai.com/v1/        LLM_MODEL=<model name>
# Claude instead:    LLM_BASE_URL=https://api.anthropic.com/v1/     LLM_MODEL=claude-haiku-5-5

TZ=Asia/Kolkata

# Telegram: create a bot with @BotFather. Leave the token empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs. Message the bot once and it replies with your ID.
TELEGRAM_ALLOWED_USER_IDS=

# Discord: create an app at discord.com/developers, add a Bot, copy its token. Empty disables Discord.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# Home Assistant: Profile > Security > Long-lived access tokens
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Jellyfin: Dashboard > API Keys
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# AdGuard Home: the admin login you created in its setup wizard
ADGUARD_URL=http://localhost
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
